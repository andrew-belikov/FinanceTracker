# docker/Dockerfile.tracker
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Runtime deps: psycopg2-binary bundles its client library.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/certs/ /usr/local/share/ca-certificates/finance_tracker/
RUN update-ca-certificates

# Python deps
COPY requirements/tracker.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY migrations/ ./migrations/
RUN pip install --no-deps .

RUN groupadd --system --gid 10001 financetracker \
 && useradd --system --uid 10001 --gid financetracker --home-dir /nonexistent --shell /usr/sbin/nologin financetracker

USER financetracker

CMD ["financetracker-tracker"]
