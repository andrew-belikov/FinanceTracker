# docker/Dockerfile.bot
FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# System deps (matplotlib runtime libs + tz/certs)
RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    libfreetype6 \
    libpng16-16 \
    libjpeg62-turbo \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python deps
COPY requirements/bot.txt ./requirements.txt
RUN pip install --require-hashes -r requirements.txt

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-deps .

RUN groupadd --system --gid 10001 financetracker \
 && useradd --system --uid 10001 --gid financetracker --home-dir /nonexistent --shell /usr/sbin/nologin financetracker \
 && install -d -m 0700 -o financetracker -g financetracker /var/lib/financetracker-bot

# Security CA trust, including operator-supplied public roots.
RUN python -c 'import certifi,pathlib; custom=sorted(pathlib.Path("/usr/local/share/ca-certificates").rglob("*.crt")); pathlib.Path("/opt/security-ca.pem").write_bytes(pathlib.Path(certifi.where()).read_bytes()+b"\n"+b"\n".join(p.read_bytes() for p in custom))' && mkdir -p /opt/security-ca-empty
ENV SSL_CERT_FILE=/opt/security-ca.pem \
    SSL_CERT_DIR=/opt/security-ca-empty \
    REQUESTS_CA_BUNDLE=/opt/security-ca.pem \
    GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/opt/security-ca.pem

USER financetracker

CMD ["financetracker-bot"]
