# docker/Dockerfile.bot
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# System deps (matplotlib runtime libs + tz/certs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    libfreetype6 \
    libpng16-16 \
    libjpeg62-turbo \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python deps
COPY requirements/bot.txt ./requirements.txt
RUN pip install --require-hashes -r requirements.txt

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-deps .

RUN groupadd --system --gid 10001 financetracker \
 && useradd --system --uid 10001 --gid financetracker --home-dir /nonexistent --shell /usr/sbin/nologin financetracker

USER financetracker

CMD ["financetracker-bot"]
