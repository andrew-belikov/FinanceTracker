FROM python:3.12-slim-trixie@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ARG XRAY_VERSION=26.10.21
ARG XRAY_SHA256_AMD64=0eec3ed4163c273d8c8bf821f7d219e257921cf584aa3fb970715e458e631978
ARG XRAY_SHA256_ARM64=d1304946c486d98e6b886e9b931eaaaebb23835b30e217638037b7f2721d4e9c
ARG TARGETARCH

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    XRAY_VERSION=${XRAY_VERSION}

RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "${arch}" in \
      amd64) asset="Xray-linux-64.zip"; archive_sha256="${XRAY_SHA256_AMD64}" ;; \
      arm64) asset="Xray-linux-arm64-v8a.zip"; archive_sha256="${XRAY_SHA256_ARM64}" ;; \
      *) echo "Unsupported TARGETARCH: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/XTLS/Xray-core/releases/download/v${XRAY_VERSION}/${asset}" -o /tmp/xray.zip; \
    echo "${archive_sha256}  /tmp/xray.zip" | sha256sum -c -; \
    mkdir -p /usr/local/share/xray; \
    unzip /tmp/xray.zip xray geoip.dat geosite.dat -d /usr/local/share/xray; \
    install -m 0755 /usr/local/share/xray/xray /usr/local/bin/xray; \
    rm -f /usr/local/share/xray/xray /tmp/xray.zip

WORKDIR /opt/finance

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-deps .

RUN groupadd --system --gid 10001 financetracker \
 && useradd --system --uid 10001 --gid financetracker --home-dir /nonexistent --shell /usr/sbin/nologin financetracker

USER financetracker

CMD ["financetracker-xray"]
